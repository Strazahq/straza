{
  "name": "auth",
  "steps": [
    {
      "note": "no bearer token → 401 with a SCIM error body",
      "request": { "method": "GET", "path": "/scim/v2/Users", "noAuth": true },
      "expect": {
        "status": 401,
        "subset": { "schemas": ["urn:ietf:params:scim:api:messages:2.0:Error"], "status": "401" }
      }
    },
    {
      "note": "a wrong token is rejected the same way",
      "request": { "method": "GET", "path": "/scim/v2/Users", "noAuth": true, "headers": { "Authorization": "Bearer not-a-real-token" } },
      "expect": { "status": 401, "subset": { "status": "401" } }
    }
  ]
}
