# syntax=docker/dockerfile:1
# Governed-harness container: pinned claude-code in a box, governed by
# straza hooks that live in THIS container's home only. Nothing here touches
# the host's user scope. Build context `straza` = this repo's root.

ARG GO_VERSION=1.26
FROM golang:${GO_VERSION}-bookworm AS straza-build
WORKDIR /src

COPY --from=straza go.mod go.sum ./
RUN go mod download

COPY --from=straza . .
ARG VERSION=dev
ARG COMMIT=none
ENV CGO_ENABLED=0
RUN go build -trimpath \
      -ldflags "-s -w -X github.com/strazahq/straza/internal/version.Version=${VERSION} -X github.com/strazahq/straza/internal/version.Commit=${COMMIT}" \
      -o /out/ ./cmd/straza

FROM node:22-bookworm-slim
# CLAUDE_VERSION mirrors CLAUDE_PINNED in test/harness-matrix/versions.env:
# a demo box demos reliably, and chasing latest is the weekly harness
# matrix's job.
# Override at build time: CLAUDE_PINNED=x.y.z docker compose ... build.
ARG CLAUDE_VERSION=2.1.220
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates procps \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code@${CLAUDE_VERSION}

COPY --from=straza-build /out/straza /usr/local/bin/straza
# git runs straza as its remote helper by this name, as the deb and rpm ship it.
RUN ln -s straza /usr/local/bin/git-remote-straza
COPY harness-entry.sh /usr/local/bin/harness-entry.sh
RUN chmod 0755 /usr/local/bin/harness-entry.sh
# straza-service (uid 64000) runs the harness's service container from this
# image. Its passwd line lets the straza client check that the socket
# belongs to the service, and Docker copies these two directories' owner and
# mode into the empty socket and state volumes the first time a container
# mounts them.
RUN groupadd --system --gid 64000 straza-service \
 && useradd --system --uid 64000 --gid 64000 --no-create-home \
      --home-dir /var/lib/straza-service --shell /usr/sbin/nologin straza-service \
 && install -d -o 64000 -g 64000 -m 0755 /run/straza-service \
 && install -d -o 64000 -g 64000 -m 0700 /var/lib/straza-service

# The node image's stock non-root user; /home/node is a volume in the
# overlay, so enrollment, hook wiring, and the operator's claude login all
# survive recreates.
# The pin above is the point of this box: the in-app auto-updater would
# fight it, and as node it cannot write the root-owned /usr/local anyway,
# so it would log an update failure in every session.
ENV DISABLE_AUTOUPDATER=1
USER node
WORKDIR /home/node
ENTRYPOINT ["/usr/local/bin/harness-entry.sh"]
