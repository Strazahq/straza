<?xml version="1.0" encoding="UTF-8"?>
<!--
  Finance Team steward: least-privilege authority for the acting human behind
  the governed agent, in the OID slot the straza-agents-demo overlay claims
  (...1c4d). Seeded UNASSIGNED: assign it to the acting human when running
  scenario A. Used by the straza-agents-demo overlay (compose.demo.yaml); do
  not delete without checking that repo.
  Why it exists - the two walls COMPOSE: the gateway's midpoint app
  impersonates the calling user (rest-3#proxy, see role-mcp-proxy.xml), so
  after straza's approve-hold releases a call, midPoint evaluates it under
  the acting user's OWN authority. Governance never conjures authority the
  user lacks. Verified on 4.10.3, in order: no steward -> assign_role ->
  held -> approved -> midPoint 403; with steward -> held -> approved ->
  applied (204).
-->

<!--
  Shape:
  - read-employees: #read on UserType scoped by archetypeRef = employee
    (...1c20). Without the scope, an impersonated search_users for jana
    answers 0 ROWS while get-by-oid works (a real model stalls at "no such
    user"). "May look up employees", not the directory.
  - assign-finance-team-only: #assign/#unassign with the target pinned by an
    Axiom inOid filter to Finance Team (...1c4c) - may grant exactly that
    role, nothing else. (Axiom text filter in an object selector works on
    4.10.3.)
  - modify-user-assignments: the execution-phase #modify restricted to item
    assignment; request phase and execution phase are authorized separately
    in midPoint.
-->
<role xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
      oid="b6f9f2c8-0d5a-4e77-9a1e-9d3c0e5a1c4d">
    <name>Finance Team steward</name>
    <description>Least-privilege grant for the human operating the governed agent: may look up employees, and may assign/unassign exactly the Finance Team role. The gateway's #proxy impersonation makes midPoint enforce THIS boundary on approved agent calls.</description>

    <authorization>
        <name>read-employees</name>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-model-3#read</action>
        <object>
            <type>UserType</type>
            <archetypeRef oid="b6f9f2c8-0d5a-4e77-9a1e-9d3c0e5a1c20" type="ArchetypeType"/>
        </object>
    </authorization>

    <authorization>
        <name>assign-finance-team-only</name>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-model-3#assign</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-model-3#unassign</action>
        <object>
            <type>UserType</type>
        </object>
        <target>
            <type>RoleType</type>
            <filter>
                <q:text>. inOid ("b6f9f2c8-0d5a-4e77-9a1e-9d3c0e5a1c4c")</q:text>
            </filter>
        </target>
    </authorization>

    <authorization>
        <name>modify-user-assignments</name>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-model-3#modify</action>
        <object>
            <type>UserType</type>
        </object>
        <item>assignment</item>
    </authorization>
</role>
