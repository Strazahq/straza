<?xml version="1.0" encoding="UTF-8"?>
<!--
  User archetype: ai-agent. An AUTONOMOUS AI agent identity: it acts under its
  own account, not on behalf of a specific person (contrast with
  personal-agent). Assigned directly (seed XML or GUI): the focus subtype is
  deprecated, so the archetype IS the typing source. The induced weak
  mappings below stamp the typology defaults into the user extension; weak =
  a hand-set per-user value always wins, and re-typing an already-typed user
  means clearing the extension attrs and recomputing. The resource outbounds
  copy the extension unchanged. The demo users nina-data-analyst-agent, sam-sre-agent and
  joe-java-developer-agent (objects/users/agent-*.xml) carry it; joe
  overrides agencyMode to supervised per-user (weak default loses).
-->
<archetype xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
           xmlns:ext="http://straza.example.com/xml/ns/straza-extension"
           oid="b6f9f2c8-0d5a-4e77-9a1e-9d3c0e5a1c22">
    <name>ai-agent</name>
    <description>Autonomous AI agent identity. Acts under its own account with its own
        role assignments; every governed action is attributed to the agent itself.
        Deactivation is the kill switch for the agent everywhere Straza governs.
        Holding this archetype types the user: strazaUserType agent, agencyMode
        autonomous (weak defaults, per-user override survives).</description>
    <archetypePolicy>
        <display>
            <label>AI agent</label>
            <pluralLabel>AI agents</pluralLabel>
            <icon>
                <cssClass>fa fa-robot</cssClass>
                <color>#a333c8</color>
            </icon>
        </display>
        <!-- sponsor derivation (templates/straza-agent-template.xml): the
             EDITABLE strazaSponsorRef user reference is the truth; the
             strazaSponsor username is derived from it (presentation-read-only)
             for the SCIM outbound -->
        <objectTemplateRef oid="b6f9f2c8-0d5a-4e77-9a1e-9d3c0e5a1c34"/>
    </archetypePolicy>
    <assignment>
        <assignmentRelation>
            <holderType>UserType</holderType>
        </assignmentRelation>
    </assignment>
    <inducement>
        <focusMappings>
            <mapping>
                <name>ai-agent-types-user</name>
                <strength>weak</strength>
                <expression><value>agent</value></expression>
                <target><path>extension/ext:strazaUserType</path></target>
            </mapping>
            <mapping>
                <name>ai-agent-agency-mode</name>
                <strength>weak</strength>
                <expression><value>autonomous</value></expression>
                <target><path>extension/ext:strazaAgencyMode</path></target>
            </mapping>
        </focusMappings>
    </inducement>
    <inducement>
        <!-- Withdraw own requests (objects/roles/role-withdraw-own-requests.xml) -->
        <targetRef oid="b6f9f2c8-0d5a-4e77-9a1e-9d3c0e5a1c03" type="RoleType"/>
    </inducement>
</archetype>
