<?xml version="1.0" encoding="UTF-8"?>
<!--
  RoleType archetype: Straza application role. Every Straza role imports as a RoleType focus
  named "BR:<role>" for a business role and "AR:<role>" for every other
  kind, and the resource's one role object type assigns the
  archetype of the role's kind with an inbound mapping on ri:roleKind
  (objects/resources/straza-resource.xml). A role's kind is fixed at create
  in Straza, so the archetype is stamped once, when the focus is born.

  The label carries the word Straza because midPoint ships stock archetypes
  named "Business role" and "Application role". The console's headings for
  the same four kinds are Business roles, Application roles, Approver roles
  and Straza roles.

  Display only: the membership construction lives in the "Straza role
  metarole" (objects/roles/role-straza-metarole.xml), which every imported
  role is assigned by an inbound mapping on the same object type.
-->
<archetype xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
           oid="b6f9f2c8-0d5a-4e77-9a1e-9d3c0e5a1c26">
    <name>straza-application-role</name>
    <description>An imported Straza application role (wire roleKind application): it carries the access row that reaches one MCP server's tools, and it is the kind a Straza policy set matches. A server-owned role names its owning server in the Server column. Imported read-only from Straza under its own name
        behind midPoint's role-type code, BR: for a business role and AR: for
        every other kind. Assigning it writes the membership, which is the
        Straza role assignment.</description>
    <archetypePolicy>
        <display>
            <label>Straza application role</label>
            <pluralLabel>Straza application roles</pluralLabel>
            <icon>
                <cssClass>fa fa-id-badge</cssClass>
                <color>#6435c9</color>
            </icon>
        </display>
    </archetypePolicy>
    <assignment>
        <assignmentRelation>
            <holderType>RoleType</holderType>
        </assignmentRelation>
    </assignment>
</archetype>
